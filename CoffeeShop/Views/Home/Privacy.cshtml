@{
    ViewData["Title"] = "Contact";
}

<section class="page-banner small">
    <div class="banner-overlay"></div>
    <div class="container text-center">
        <h1>Contact</h1>
    </div>
</section>

<div class="container py-5">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h3>CoffeeShop</h3>
            <p>
                CoffeeShop cam kết cung cấp sản phẩm chất lượng, giá cả rõ ràng
                và hỗ trợ khách hàng khi có vấn đề với đơn hàng.
            </p>

            <h5>Thông tin đơn hàng</h5>
            <p>Thông tin khách hàng chỉ được dùng để xác nhận và giao đơn hàng.</p>

            <h5>Đổi trả</h5>
            <p>Nếu sản phẩm giao sai hoặc gặp lỗi, khách hàng có thể liên hệ cửa hàng để được hỗ trợ.</p>
        </div>
    </div>
</div>
